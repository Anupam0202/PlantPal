{
  "name": "plantpal",
  "private": true,
  "version": "3.0.0-alpha.0",
  "description": "PlantPal — turn constrained urban spaces into healthy, productive, climate-resilient and biodiverse living spaces.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @plantpal/web dev",
    "dev:api": "pnpm --filter @plantpal/api dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @plantpal/web e2e",
    "check:dist": "node tools/scan-dist.mjs apps/web/dist",
    "ci": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm check:catalog && pnpm test && pnpm build && pnpm check:dist && pnpm check:bundle && pnpm check:headers",
    "check:bundle": "node tools/check-bundle.mjs apps/web/dist",
    "check:headers": "node tools/sync-headers.mjs --check",
    "check:catalog": "tsx tools/validate-catalog.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@plantpal/catalog": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.0.0",
    "axe-core": "^4.14.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fake-indexeddb": "^6.2.6",
    "fast-check": "^4.10.2",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.4",
    "prettier": "^3.8.1",
    "tsx": "4.23.15",
    "turbo": "^2.11.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
